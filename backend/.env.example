# ===================================================================
# Psychometric Assessment Platform - Environment Configuration Example
# Copy this file to '.env' (which is gitignored) and fill in actual values.
# NEVER commit real credentials or .env files to GitHub.
# ===================================================================

# -------------------------------------------------------------------
# Application & Server Configuration
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# -------------------------------------------------------------------
# MySQL Database Configuration
# In production on AWS EC2, replace localhost with your RDS endpoint or local MySQL
# -------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/psychometric_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=psychometric_user
DB_PASSWORD=your_secure_db_password_here

# -------------------------------------------------------------------
# Redis Cache Configuration
# In production, point to AWS ElastiCache Redis or local Redis instance
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------------
# JWT Security Configuration
# CRITICAL: Must be a secure, random Base64 or plain string of AT LEAST 256 bits (32 bytes).
# Generate a new key with: openssl rand -base64 32
# -------------------------------------------------------------------
JWT_SECRET=your_base64_encoded_256_bit_secure_jwt_secret_here

# -------------------------------------------------------------------
# Spring Mail (SMTP) Configuration (e.g. Gmail App Password or AWS SES)
# -------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# -------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Allowed Origins
# Comma-separated list of allowed frontend domains
# Includes the live domain https://psychometricarab.com
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://psychometricarab.com,https://www.psychometricarab.com,https://api.psychometricarab.com,https://omarharaz.github.io,http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------------
# Cloudinary CDN Configuration (Item Images & Generated PDF Reports)
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=psychometric

# -------------------------------------------------------------------
# Gemini AI Configuration (Report Generation / Analysis)
# -------------------------------------------------------------------
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------------
# JPA / Hibernate & Logging Configuration
# In production, set JPA_DDL_AUTO to 'update' or 'validate', and turn off SQL logging.
# -------------------------------------------------------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
HIBERNATE_LOG_LEVEL=WARN
SECURITY_LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Psychometric Scoring Validity & Penalty Thresholds (Optional Defaults)
# -------------------------------------------------------------------
CENTRAL_TENDENCY_CUTOFF_PCT=45.0
SD_PENALTY_THRESHOLD_PCT=60.0
SD_PENALTY_RATE=0.15
CT_PENALTY_THRESHOLD_PCT=45.0
CT_PENALTY_RATE=0.15
MAX_PENALTY_CAP_PCT=15.0
